<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- minSdk уже 33 — разрешение обязательно на всех поддерживаемых
         версиях, запрашивается при первом запуске (см. MainActivity). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Разовая геометка к событию в момент нажатия кнопки, не слежение за
         маршрутом — поэтому ACCESS_BACKGROUND_LOCATION не нужен, только
         foreground-доступ. COARSE рядом с FINE — на случай, если водитель
         даст только приблизительное: лучше неточная метка, чем никакой
         (см. GeoTagProvider). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Своя камера в приложении: фото на этапах рейса и QR водителя при
         привязке. Запрашивается при первом запуске вместе с остальными. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Самообновление со шлюза (AppUpdater): установка своей новой версии.
         Первое — «Установка неизвестных приложений», водитель включает один
         раз; второе — чтобы дальше система ставила обновление без вопросов. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".ArmDriverApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ArmDriver"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ArmDriver">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Камера и сканер QR — отдельное окно, не диалог: на Xiaomi
             диалог уходил под системные кнопки (см. CameraActivity). Портрет —
             чтобы поворот не пересоздавал экран посреди съёмки. -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ArmDriver" />

        <receiver
            android:name=".data.update.UpdateStatusReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.update.AppUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".push.ArmDriverFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Канал "assignments" совпадает с android.notification.channel_id
             в FCM-payload шлюза (internal/push/fcm.go) — там же приоритет и
             звук, здесь только откуда взять иконку/цвет, если система сама
             рисует уведомление (killed-app; см. ArmDriverApp про сам канал). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_foreground" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="assignments" />
    </application>

</manifest>
