ARM_DRIVER_DOMAIN=driver.example.ru

# Токен для запросов от 1С к шлюзу.
GATEWAY_TOKEN=change-me-1c

# Токен для запросов мобильного приложения к шлюзу.
# Если пустой, используется GATEWAY_TOKEN.
MOBILE_TOKEN=change-me-mobile

# Базовый URL 1С для форвардинга событий:
# POST ${ONE_C_BASE_URL}/prtr_driver/events
ONE_C_BASE_URL=https://one-c.example.local
ONE_C_TOKEN=change-me-one-c
ONE_C_USERNAME=
ONE_C_PASSWORD=

# Если пусто, push только логируется. Для реальной отправки FCM смонтировать
# service account JSON в контейнер и указать путь внутри контейнера.
FCM_SERVICE_ACCOUNT_FILE=

HTTP_PORT=8080
DATA_DIR=/app/data

# Сроки хранения фото документов (technical delivery-cache), в днях.
# Значения ниже — дефолты, строки можно не добавлять, если устраивают.
# DOCUMENT_PENDING_RETENTION_DAYS=90
# DOCUMENT_DELIVERED_RETENTION_DAYS=7

# Сколько держать XML разнарядок в delivery-cache, в днях.
# ASSIGNMENT_RETENTION_DAYS=30

# За какое окно отдавать разнарядки телефону (GET /api/mobile/assignments).
# 48 часов покрывают выдачу «с вечера» плюс весь рабочий день.
# ASSIGNMENT_LIST_WINDOW_HOURS=48

# Через сколько минут после прихода разнарядки напоминать водителю, что он её
# не принял. У водителя час на приём, дальше диспетчер звонит вручную.
# ASSIGNMENT_REMINDER_FIRST_MINUTES=30
# ASSIGNMENT_REMINDER_SECOND_MINUTES=50
